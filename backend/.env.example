# LLM Provider (gemini, claude, or openrouter)
LLM_PROVIDER=gemini

# Gemini API (get key at https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Claude API
ANTHROPIC_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-3.8-flash

# Score threshold for retrieval (cross-encoder raw logit, -10 to +10)
SCORE_THRESHOLD=-2.0

# ChromaDB
CHROMA_DB_PATH=./chroma_db

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ColPali (set to true to enable visual page processing)
COLPALI_ENABLED=false
COLPALI_MODEL=vidore/colpali-v1.2

# Server
HOST=0.0.0.0
PORT=8000
